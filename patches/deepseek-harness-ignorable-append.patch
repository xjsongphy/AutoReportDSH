+import { describe, expect, expectTypeOf, it } from 'vitest'
+import { Session, SessionEvent, SessionId } from '@deepseek-ai/dsh-session'
+import type { AppendOptions } from '@deepseek-ai/dsh-session'
+
+describe('Session.append options', () => {
+  it('marks a non-surface event ignorable when the writer passes { ignorable: true }', () => {
+    const session = Session.create(SessionId('append-ignorable'))
+    const event = session.append('turn/start', { turn: 1 }, { ignorable: true })
+
+    expect(event.ignorable).toBe(true)
+    expect(session.events[0]?.ignorable).toBe(true)
+  })
+
+  it('leaves non-surface events required-on-read without options or with empty options', () => {
+    const session = Session.create(SessionId('append-required'))
+    const noOptions = session.append('turn/start', { turn: 1 })
+    const emptyOptions = session.append('step/start', { turn: 1, step: 1 }, {})
+
+    expect(noOptions.ignorable).toBeUndefined()
+    expect(emptyOptions.ignorable).toBeUndefined()
+  })
+
+  it('keeps the marker on the frozen logged entry, not only the returned event', () => {
+    const session = Session.create(SessionId('append-frozen'))
+    session.append('turn/start', { turn: 7 }, { ignorable: true })
+    session.append('turn/end', { turn: 7, reason: { kind: 'completed' } })
+
+    expect(session.events.map(event => event.ignorable)).toEqual([true, undefined])
+    expect(Object.isFrozen(session.events[0])).toBe(true)
+  })
+
+  it('still requires surface metadata for surface events and rejects it for log-only events at compile time', () => {
+    const session = Session.create(SessionId('append-surface-compile'))
+
+    // Surface events keep their SurfaceIntent parameter; the compiler enforces
+    // the shape through the conditional tuple, so this compiles only because
+    // the call carries the required intent.
+    session.append('user/message', {
+      content: [{ type: 'text', text: 'q' }],
+      source: { kind: 'user' },
+    }, { surfaceOp: 'append' })
+
+    expectTypeOf<AppendOptions>().toMatchTypeOf<{ ignorable?: true }>()
+    // A log-only event accepts the optional options parameter...
+    session.append('turn/start', { turn: 2 })
+    // ...and the returned event type stays tied to the appended kind.
+    expectTypeOf(session.append('turn/start', { turn: 3 })).toEqualTypeOf<SessionEvent<'turn/start'>>()
+  })
+})
